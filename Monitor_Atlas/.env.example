DJANGO_DEBUG=1
DJANGO_SECRET_KEY=your_secret_key
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_PREFIX=monitor_

CHIRPSTACK_JWT_TOKEN=your_jwt_token
CHIRPSTACK_BASE_URL=http://localhost:8090/api

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
CORS_ALLOW_CREDENTIALS=true

CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax
COOKIE_SECURE=false

REFRESH_TOKEN_DURATION=1
ACCESS_TOKEN_DURATION=60

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_SECRET=your_google_secret
GOOGLE_ISS=accounts.google.com

MAILGUN_API_KEY=your_mailgun_key
MAILGUN_DOMAIN=yourdomain.com
MAILGUN_FROM="Soporte <soporte@yourdomain.com>"
APP_URL=http://localhost:5173

MTR_LOGO_URL=https://placehold.co/300x150.png

HERMES_WS_URL=ws://localhost:5000
HERMES_API_URL=http://localhost:5000
WS_SECRET=your_ws_secret

FIREBASE_ADMIN_CREDENTIALS=firebase-credentials.json

# Cloudflare R2 Object Storage Configuration
USE_R2=false
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_CUSTOM_DOMAIN=https://pub-<hash>.r2.dev
R2_REGION_NAME=auto
